# ATLAS Home Configuration

# DroidCam / Camera Stream URL
# Example for DroidCam over Wi-Fi (replace <PHONE_IP> with phone's IP shown in the DroidCam app):
# ATLAS_CAMERA_URL=http://192.168.1.50:4747/video
# Or for MJPEG feed:
# ATLAS_CAMERA_URL=http://192.168.1.50:4747/mjpegfeed
# For RTSP feed (if using IP Webcam or RTSP camera):
# ATLAS_CAMERA_URL=rtsp://192.168.1.50:8080/h264_pcm.sdp
# Or use integrated/USB webcam index for local hardware testing:
# ATLAS_CAMERA_URL=0
ATLAS_CAMERA_URL=http://192.168.1.100:4747/video

# ATLAS Device Identifier
ATLAS_DEVICE_ID=atlas_home_01

# API Server Configuration
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=5000

# Environment Mode (development / production)
ATLAS_ENV=development

# Camera connection parameters
ATLAS_CAMERA_RETRY_INTERVAL_SEC=3.0
ATLAS_CAMERA_BUFFER_SIZE=1
